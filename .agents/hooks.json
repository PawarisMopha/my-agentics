{
  "security-gate": {
    "enabled": true,
    "pre_tool_execution": [
      {
        "matcher": "code_execution",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./.agents/hooks-scripts/gate.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "auto-format-and-audit": {
    "enabled": true,
    "post_tool_execution": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./.agents/hooks-scripts/post_hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
